{
  "description": "Adaptadores locais dos hooks canônicos de governança do projeto Minerva.",
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|clear|compact", "hooks": [
      {"type": "command", "command": "bash .codex/hooks/sessao-orquestrador.sh", "statusMessage": "Carregando o papel do orquestrador", "additionalContextLimit": 8000},
      {"type": "command", "command": "bash .codex/hooks/sincronizar-continuidade.sh init", "statusMessage": "Inicializando a continuidade"}
    ]}],
    "PreToolUse": [{"matcher": "Bash|apply_patch", "hooks": [
      {"type": "command", "command": "bash .codex/hooks/guarda-orquestrador.sh", "statusMessage": "Verificando a delegação"}
    ]}],
    "PostToolUse": [{"matcher": "Bash|apply_patch", "hooks": [
      {"type": "command", "command": "bash .codex/hooks/sincronizar-continuidade.sh sync", "statusMessage": "Sincronizando a continuidade"}
    ]}]
  }
}
